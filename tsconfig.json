{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": [
    "shared/src/**/*.ts",
    "shared/test/**/*.ts",
    "agent/src/**/*.ts",
    "agent/test/**/*.ts",
    "mcp/src/**/*.ts",
    "mcp/test/**/*.ts",
    "web/app/**/*.ts",
    "web/app/**/*.tsx",
    "web/src/**/*.ts",
    "web/src/**/*.tsx",
    "web/next-env.d.ts",
    "web/next.config.ts"
  ]
}
