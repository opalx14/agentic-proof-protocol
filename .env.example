# Monad Testnet defaults (non-secret)
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_TESTNET_CHAIN_ID=10143
MONAD_TESTNET_EXPLORER_URL=https://testnet.monadvision.com

# Agent API. Use AGENT_PORT when web + API share one hosted service so the platform PORT remains available to Next.js.
PORT=8787
AGENT_PORT=8787
HOST=0.0.0.0
APP_RPC_URL=https://testnet-rpc.monad.xyz
APP_CHAIN_ID=10143
APP_CONTRACT_ADDRESS=
APP_EXPLORER_URL=https://testnet.monadvision.com
APP_AGENT_ADDRESS=
# Never commit a private key. Prefer a Foundry keystore for deploys; set this locally only for the demo agent signer.
APP_AGENT_PRIVATE_KEY=
APP_AUDIT_PATH=./data/audit.jsonl

# Optional AI proposal provider. If GROQ_API_KEY is blank, proposals use an explicitly-labelled deterministic fallback.
APP_MODEL_MODE=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# MCP: local stdio works without a token. Remote Streamable HTTP is DISABLED
# until a private, randomly generated 32+ character token is provisioned server-side.
# Never put this value in NEXT_PUBLIC_* or in a repository.
APP_MCP_BEARER_TOKEN=
# Preferred for hosted deployments: store only the SHA-256 digest of the private bearer token.
# Example digest generation: printf '%s' "$APP_MCP_BEARER_TOKEN" | shasum -a 256 | awk '{print $1}'
APP_MCP_BEARER_TOKEN_SHA256=
AGENTIC_PROOF_API_URL=http://127.0.0.1:8787

# Next.js public browser config. Omit NEXT_PUBLIC_AGENT_API_URL to use the same-origin /agent-api proxy.
NEXT_PUBLIC_AGENT_API_URL=/agent-api
AGENT_API_INTERNAL_URL=http://127.0.0.1:8787
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_EXPLORER_URL=https://testnet.monadvision.com
