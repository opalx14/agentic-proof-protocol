# Next.js browser configuration for Monad Testnet.
# Copy to web/.env.local after the registry is deployed.
# Keep browser API calls same-origin by default; Next proxies /agent-api/* to the internal Fastify service.
NEXT_PUBLIC_AGENT_API_URL=/agent-api
AGENT_API_INTERNAL_URL=http://127.0.0.1:8787
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_EXPLORER_URL=https://testnet.monadvision.com
